{
  "name": "civic-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first crisis communication and coordination platform",
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:properties": "node --test packages/senda/tests/properties-critical.test.mjs",
    "test:coverage": "node packages/senda/scripts/run-coverage-f2.mjs",
    "test:mutation": "node packages/senda/scripts/run-mutation-f2.mjs",
    "lint": "pnpm -r type-check",
    "type-check": "pnpm -r type-check",
    "manifest": "node scripts/release-manifest.mjs"
  },
  "keywords": [
    "crisis",
    "communication",
    "offline-first",
    "mesh",
    "emergency"
  ],
  "author": "Abraham Haddioui",
  "license": "MIT",
  "dependencies": {
    "i18next": "^26.4.2",
    "react-i18next": "^17.0.13"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@types/node": "^20.17.14",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.14.1",
    "c8": "^12.0.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": "2.0.8",
      "body-parser": "1.20.9",
      "qs": "6.16.0",
      "source-map-js": "1.2.2",
      "postcss-selector-parser": "7.1.6"
    }
  }
}
