{
  "name": "@senda/live",
  "version": "0.1.0",
  "private": true,
  "description": "SENDA LIVE — red social de acontecimientos con puente a la capa de emergencias SENDA. Backend Node 22 (node:sqlite, sin dependencias) + PWA React.",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/index.mjs",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "type-check": "tsc -p web/tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "migrate": "node --disable-warning=ExperimentalWarning server/cli.mjs migrate",
    "cli": "node --disable-warning=ExperimentalWarning server/cli.mjs"
  },
  "dependencies": {
    "@senda/core": "workspace:*",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.161.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.161.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT"
}
