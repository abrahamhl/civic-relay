<?xml version="1.0" encoding="utf-8"?>
<!-- Solo en la versión «Play»: detección «en vehículo» de Google Play Services. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <!-- Solo en «Play»: incidencias de la DGT en vivo (nap.dgt.es) en Conducir. La base sigue sin Internet. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <receiver android:name=".VehicleHintReceiver" android:exported="false"/>
        <!-- Android Auto / Google integrado (Car App Library). Categoría POI PROVISIONAL: por confirmar con Google. -->
        <service android:name=".SendaCarAppService" android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService"/>
                <category android:name="androidx.car.app.category.POI"/>
            </intent-filter>
        </service>
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1"/>
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc"/>
    </application>
</manifest>
