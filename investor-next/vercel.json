{
  "framework": "nextjs",
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/vision-master.md",
      "destination": "/vision-master.txt"
    },
    {
      "source": "/research/:slug.html",
      "destination": "/research/:slug"
    }
  ]
}
