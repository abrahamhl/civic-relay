{
  "rewrites": [
    {
      "source": "/senda",
      "destination": "/senda/index.html"
    },
    {
      "source": "/senda/",
      "destination": "/senda/index.html"
    },
    {
      "source": "/senda/:page(app|descargas|ruta|conducir|copiloto|reportar|comite|agua|agua-nl|aislamiento|arquitectura|atlas|avisos|barrido|camaras|carretera|centro|ciclo|consola|demo|dgt|dron|edificios|estado|evacuacion|explica|explorador|fuego|fuego3d|dana4d|incendio|incendio4d|incidente|llamada|mensaje|monte|mulas|ojo|organismo|paises|paper|plataforma|radar|radio|red|referencias|reserva|roadsafe|sala|sentidos|simulador|trafico|tren4d|personas|triaje|vehiculos|via|viaje|visor|vuelo)",
      "destination": "/senda/:page.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' https://tiles.openfreemap.org https://router.project-osrm.org https://routing.openstreetmap.de https://service.pdok.nl https://tms-pnoa-ma.idee.es https://gibs.earthdata.nasa.gov https://s3.amazonaws.com/elevation-tiles-prod/ https://tile.opentopomap.org https://nominatim.openstreetmap.org https://earthquake.usgs.gov https://www.seismicportal.eu https://www.gdacs.org https://eonet.gsfc.nasa.gov; media-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/senda/:page(copiloto|conducir|reportar|comite|personas|tren4d|dana4d|incendio4d|explorador)(.html)?",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' https://tiles.openfreemap.org https://router.project-osrm.org https://routing.openstreetmap.de https://service.pdok.nl https://tms-pnoa-ma.idee.es https://gibs.earthdata.nasa.gov https://s3.amazonaws.com/elevation-tiles-prod/ https://tile.opentopomap.org https://nominatim.openstreetmap.org; media-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/media/m95/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    },
    {
      "source": "/senda/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/senda/:path*",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(self), microphone=(self), payment=()"
        }
      ]
    },
    {
      "source": "/senda-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/release-provenance.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/platform",
      "destination": "/senda/sala",
      "permanent": false
    },
    {
      "source": "/platform/",
      "destination": "/senda/sala",
      "permanent": false
    },
    {
      "source": "/es/platform",
      "destination": "/senda/sala",
      "permanent": false
    },
    {
      "source": "/es/platform/",
      "destination": "/senda/sala",
      "permanent": false
    },
    {
      "source": "/nl/platform",
      "destination": "/senda/sala",
      "permanent": false
    },
    {
      "source": "/nl/platform/",
      "destination": "/senda/sala",
      "permanent": false
    }
  ]
}
