{
  "schema": "senda-calibration-sources/1",
  "updated_utc": "2026-11-07",
  "purpose": "Source discovery and per-engine independent evaluation planning; this does NOT certify, download, or calibrate a SENDA model.",
  "policy": {
    "allowed_statuses": [
      "NOT_INGESTED",
      "QUARANTINED",
      "VERIFIED_OFFLINE"
    ],
    "default_status": "NOT_INGESTED",
    "never_implies": [
      "field-validated",
      "operationally-authorised",
      "sensor-calibrated",
      "access-granted"
    ],
    "split_unit": "event_or_site_or_fire_with_time_holdout",
    "retrospective_cutoff": "Each feature must have available_at_utc <= inference_at_utc. No post-event data in input features.",
    "observation_requirements": [
      "source URL and acquisition timestamp",
      "UTC capture and availability timestamp",
      "licence and operator permissions checked",
      "original immutable bytes SHA-256",
      "quality/missing-value masks",
      "independent held-out truth source",
      "sensor calibration, unit and spatial footprint"
    ]
  },
  "engines": {
    "fire-hotspots": [
      "noaa-goes-fhs",
      "nasa-firms-viirs-standard",
      "nist-camp-fire",
      "usgs-mtbs",
      "copernicus-effis"
    ],
    "fire-spread-3d": [
