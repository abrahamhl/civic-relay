        "fire-hotspots",
        "fire-spread-3d",
        "weather-wind-smoke"
      ],
      "role": "thermal anomaly predictor",
      "official_url": "https://www.noaasis.noaa.gov/pdf/ps-pvr/goes18/ABI/Fires%20and%20Hot%20Spots%20Characterization/Full/GOES-18_ABI_L2_FireHotSpot_Full_ReadMe.pdf",
      "access": "PUBLIC_PRODUCT",
      "rights": "REVIEW_PER_PRODUCT_AND_USE_CASE",
      "ingestion": "NOT_INGESTED",
      "limitations": [
        "Require original Mask/DQF and scan timestamps; a hot pixel is not a fire front.",
        "No operational fire spread claim from pixel centroids."
      ]
    },
